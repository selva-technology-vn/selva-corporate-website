{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "selva-corporate-website",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "selva-website-production",
      "database_id": "00df897f-1bfb-4aca-919e-003abc357581",
      "migrations_dir": "./drizzle"
    }
  ],
  "vars": {
    "ADMIN_ENABLED": "false",
    "PUBLIC_INDEXING": "false"
  },
  "observability": {
    "enabled": true
  }
}
