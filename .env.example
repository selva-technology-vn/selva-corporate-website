# Comma-separated lowercase/uppercase emails are both accepted.
ADMIN_EMAILS=founder@example.com

# Set false on the zero-billing-risk Cloudflare deployment. Sites private owns
# the Sign in with ChatGPT administration flow.
ADMIN_ENABLED=true

# Server-only Resend integration. Never expose these as NEXT_PUBLIC_*.
RESEND_API_KEY=
CONTACT_TO_EMAIL=selvatech.company@gmail.com
CONTACT_FROM_EMAIL=SELVA Website <contact@your-domain.example>

# Keep false for staging. Enable only after founder approves legal/content launch.
PUBLIC_INDEXING=false

# Optional. GA property must be owned by founder/SELVA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
